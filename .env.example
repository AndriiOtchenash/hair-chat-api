# dev | prod
ENV=
# e.g. postgresql+asyncpg://user:password@localhost:5432/hair_chat
DATABASE_URL=
# provider:model links in priority order (models: app/llm/registry.py); empty = default
# gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
LLM_CHAIN=
# seconds; empty = defaults 5 / 20 / 30
LLM_CONNECT_TIMEOUT_S=
LLM_FIRST_TOKEN_TIMEOUT_S=
LLM_READ_TIMEOUT_S=
# prod: paid-tier key (free tier may use prompts for training)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Auth0 tenant domain without scheme, e.g. hair-chat.eu.auth0.com (required when ENV=prod)
AUTH0_DOMAIN=
# Auth0 API identifier, checked against the token's aud claim (required when ENV=prod)
AUTH0_AUDIENCE=
# Version of the consent texts (docs/consents/README.md); bump it whenever a text changes
CONSENT_VERSION=
