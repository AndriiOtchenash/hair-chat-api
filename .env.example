# dev | staging | prod (staging = prod checks, KB_INCLUDE_DRAFTS=true allowed)
ENV=
# e.g. postgresql+asyncpg://user:password@localhost:5432/hair_chat; a libpq URL (Neon:
# postgresql://...?sslmode=require&channel_binding=require) is converted for asyncpg
DATABASE_URL=
# provider:model links in priority order (models: app/llm/registry.py); empty = default
# gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
LLM_CHAIN=
# seconds; empty = defaults 5 / 20 / 30
LLM_CONNECT_TIMEOUT_S=
LLM_FIRST_TOKEN_TIMEOUT_S=
LLM_READ_TIMEOUT_S=
# max tokens per chat answer (incl. reasoning tokens); empty = 2048
CHAT_MAX_ANSWER_TOKENS=
# input tokens per chat call (system prompt + summary + history); empty = 6000
CONTEXT_BUDGET_TOKENS=
# prod: paid-tier key (free tier may use prompts for training)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Input moderation (omni-moderation-latest); required when ENV is staging/prod, empty in dev = no moderation
OPENAI_API_KEY=
# seconds; empty = 3 (on timeout the message passes unchecked, ADR 0004)
MODERATION_TIMEOUT_S=
# violence / violence/graphic block only from this score (0..1); empty = 0.9 (ADR 0004)
MODERATION_VIOLENCE_THRESHOLD=
# Auth0 tenant domain without scheme, e.g. hair-chat.eu.auth0.com (required when ENV is staging/prod)
AUTH0_DOMAIN=
# Auth0 API identifier, checked against the token's aud claim (required when ENV is staging/prod)
AUTH0_AUDIENCE=
# Auth0 Management API (M2M application with the delete:users scope): DELETE /me also deletes
# the Auth0 account; empty = only our data is deleted (warning in the log, ADR 0006)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# python -m app.cli.retention deletes conversations idle for longer than this; empty = 30
RETENTION_DAYS=
# Version of the consent texts (docs/consents/README.md); bump it whenever a text changes
CONSENT_VERSION=
# Knowledge base (RAG, ADR 0005). Embeddings via Gemini (GEMINI_API_KEY); no key = no RAG.
# One model for the whole index: changing it requires `python -m app.rag.ingest docs/kb`.
# empty = gemini-embedding-2 / 768 (must match vector(768) in kb_chunks)
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# seconds for the query embedding in a chat reply; empty = 3 (on timeout: answer without KB)
EMBEDDING_TIMEOUT_S=
# empty = 4 chunks per question / 0.60 min cosine similarity (scripts/rag_eval.py) / 1500 tokens
# of <knowledge>
KB_TOP_K=
KB_MIN_SIMILARITY=
KB_MAX_TOKENS=
# search draft articles too; empty = true in dev, false in staging/prod (prod refuses true)
KB_INCLUDE_DRAFTS=
